{
  "name": "serverless-simple-middleware",
  "description": "Simple middleware to translate the interface of lambda's handler to request => response",
  "version": "0.0.75",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "VoyagerX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/v6x/serverless-simple-middleware.git"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "serverless"
  ],
  "bugs": {
    "url": "https://github.com/v6x/serverless-simple-middleware/issues"
  },
  "homepage": "https://github.com/v6x/serverless-simple-middleware#readme",
  "scripts": {
    "lint": "tslint --project tsconfig.json",
    "clean": "rm -rf dist && rm -rf node_modules && yarn install",
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:db": "docker run --rm -d --name ssm-test-mysql -e MYSQL_ROOT_PASSWORD='test***' -p 3306:3306 mysql:8 >/dev/null && for i in $(seq 60); do docker exec ssm-test-mysql mysqladmin ping -h127.0.0.1 -uroot -p'test***' --silent >/dev/null 2>&1 && break; sleep 1; done; TEST_MYSQL=1 jest --config jest.config.js; ec=$?; docker stop ssm-test-mysql >/dev/null; exit $ec",
    "deploy": "yarn build && yarn publish"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.828.0",
    "@aws-sdk/client-s3": "^3.828.0",
    "@aws-sdk/client-secrets-manager": "3.828.0",
    "@aws-sdk/client-sqs": "^3.828.0",
    "@aws-sdk/cloudfront-signer": "^3.821.0",
    "@aws-sdk/lib-dynamodb": "^3.828.0",
    "@aws-sdk/lib-storage": "^3.828.0",
    "@aws-sdk/s3-request-presigner": "^3.828.0",
    "@types/aws-lambda": "8",
    "cross-fetch": "^2.2.2",
    "kysely": "^0.28.2",
    "mysql2": "^3.14.1",
    "simple-staging": "^0.0.12",
    "ts-enum-util": "^3.1.0",
    "uuid": "^3.3.2",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/jest": "^29",
    "@types/node": "18",
    "@types/uuid": "^3.4.4",
    "cross-env": "^5.2.0",
    "jest": "^29",
    "prettier": "3.3.3",
    "ts-jest": "^29",
    "tslint": "^5.11.0",
    "tslint-config-prettier": "^1.14.0",
    "typescript": "5.5.3"
  },
  "prettier": {
    "printWidth": 80,
    "singleQuote": true,
    "trailingComma": "all"
  }
}
